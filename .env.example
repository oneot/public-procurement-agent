# ──────────────────────────────────────────────────────────────
#  로컬 개발용 환경변수 예시. `.env` 로 복사해 값을 채우세요.
#  cp .env.example .env      (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)
#  이미 설정된 셸 환경변수가 .env 보다 우선합니다.
# ──────────────────────────────────────────────────────────────

# [필수] 공공데이터포털(data.go.kr) '조달청_나라장터 입찰공고정보서비스' 인증키
#        포털의 Decoding 키를 권장하지만 Encoding 키(%2B 등 포함)도 자동으로 처리합니다.
NARA_SERVICE_KEY=

# [발송 시] Azure Communication Services Email
ACS_CONNECTION_STRING=
# 예: DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net
MAIL_SENDER=
# 쉼표(,)·세미콜론(;)으로 여러 명 지정
MAIL_TO=

# [선택] 이메일 브랜딩 — 비워 두면 기본값(중립 문구)을 사용합니다.
# 문구에는 {year}, {date}, {brand_name} 자리표시자를 쓸 수 있습니다.
# BRIEF_BRAND_NAME=
# BRIEF_LOGO_URL=https://example.com/logo.png
# BRIEF_LOGO_MARK_COLORS=#f97316,#22c55e,#3b82f6,#eab308
# BRIEF_EYEBROW=Weekly Korea K-12 Market Procurement Brief
# BRIEF_TITLE=🇰🇷 K-12 Public Procurement Agent
# BRIEF_SECTION_LABEL=✨ 이번주 주목할 주요 사업 기회 · 마감 임박순
# BRIEF_FOOTER_TEXT=© {year} {brand_name}. All rights reserved.
# BRIEF_EMAIL_SUBJECT=WEEKLY KOREA K-12 MARKET PROCUREMENT BRIEF | {date}
